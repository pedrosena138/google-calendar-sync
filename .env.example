# From https://console.cloud.google.com/apis/credentials -> OAuth client ID -> Web application
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx

# Must exactly match an authorised redirect URI of the OAuth client above
GOOGLE_REDIRECT_URI=http://127.0.0.1:8085/oauth/callback

# Optional overrides
# GOOGLE_CALENDAR_ID=primary
# TIMEZONE=Europe/Lisbon